# ---------------------------------------------------------------------------
# VEXO — variáveis de ambiente
# Copie para .env (local) ou configure como variáveis de serviço no Railway.
# ---------------------------------------------------------------------------

# Banco de dados (Postgres gerenciado no Railway)
DATABASE_URL="postgresql://user:password@localhost:5432/vexo"

# URL pública da aplicação (usada em redirects de OAuth e links de notificação)
APP_URL="https://app.vexo.com.br"

# NextAuth
NEXTAUTH_URL="https://app.vexo.com.br"
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"

# Criptografia de tokens OAuth em repouso (Instagram / Google Calendar)
TOKEN_ENCRYPTION_KEY="gere-com-openssl-rand-hex-32"

# Anthropic (Claude)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_CONVERSATION_MODEL="claude-sonnet-5"
ANTHROPIC_BACKSTAGE_MODEL="claude-haiku-4-5-20251001"

# Meta / Instagram Messaging (Login do Facebook para Empresas)
META_APP_ID=""
META_APP_SECRET=""
META_OAUTH_REDIRECT_URI="https://app.vexo.com.br/api/oauth/instagram/callback"
META_WEBHOOK_VERIFY_TOKEN="defina-um-valor-aleatorio"

# Google Calendar OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="https://app.vexo.com.br/api/oauth/google-calendar/callback"

# WhatsApp — Evolution API (self-hosted). Cada clínica tem sua própria
# instância (Clinic.whatsappInstanceName, pareada por QR code em
# /crm/clinicas/[id]/whatsapp), então só a URL e a key globais vêm daqui.
EVOLUTION_API_URL="https://evolution.vexo.com.br"
EVOLUTION_API_KEY=""

# Timing adaptativo de resposta da IA (segundos) — opcional, valores padrão já
# refletem a especificação (delay curto fixo na primeira resposta).
AI_FIRST_REPLY_DELAY_SECONDS=40
AI_MIN_REPLY_DELAY_SECONDS=15
AI_MAX_REPLY_DELAY_SECONDS=900

# O prazo do gatilho "parou de responder" e as duas sequências de follow-up
# (SILENCE / NO_SHOW) são configurados pela interface em /crm/follow-up, não
# por variável de ambiente.

# Seed inicial (usuário interno admin) — usado por `npm run prisma:seed`
SEED_ADMIN_EMAIL="mauro@m8growth.com"
SEED_ADMIN_PASSWORD="troque-esta-senha"

# Alternativa ao seed via CLI: habilita a tela pública /setup para criar o
# primeiro admin pela interface. Só funciona enquanto não existir nenhum
# admin no banco. Gere com `openssl rand -hex 32` e REMOVA esta variável
# depois de criar o admin (a tela já se desabilita sozinha, mas remover é
# mais seguro).
ADMIN_SETUP_TOKEN=""
