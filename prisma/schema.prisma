// VEXO — schema de dados multi-tenant
// Cada Clinic é um tenant isolado (conversas, leads, integrações, usuários).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy / usuários
// ---------------------------------------------------------------------------

enum UserRole {
  INTERNAL_ADMIN // Mauro / equipe M8 Growth — acesso total ao CRM
  INTERNAL_STAFF // secretária/atendente interna — acesso ao CRM
  CLIENT // login da clínica — painel somente leitura
}

model Clinic {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  timezone String  @default("America/Sao_Paulo")
  active   Boolean @default(true)

  // Piloto 21D
  pilotStartedAt DateTime?
  pilotEndsAt    DateTime?

  // Contato para escalonamento humano e resumo semanal
  notifyWhatsappNumber String? // Mauro/secretária desta clínica
  clientWhatsappNumber String? // número da clínica p/ resumo semanal

  // Instância própria na Evolution API — cada clínica tem seu próprio
  // WhatsApp, pareado via QR code (ver src/lib/whatsapp-connection.ts).
  // Default (na criação) é o slug da clínica; pode ser renomeado antes do
  // primeiro pareamento, ex. pra reaproveitar uma instância já validada.
  whatsappInstanceName    String?   @unique
  // Último estado confirmado via GET /instance/connectionState — "open" |
  // "connecting" | "close" | "unknown". Não é live: só atualiza quando
  // alguém abre a tela de conexão ou clica em "verificar conexão".
  whatsappStatus          String?
  whatsappStatusCheckedAt DateTime?

  // Prompt de conversação (fornecido pelo Mauro, por clínica)
  aiSystemPrompt String? @db.Text

  // Vídeo fixo do médico (gravado uma vez) enviado automaticamente pelo
  // Instagram assim que um agendamento é confirmado na conversa (ver
  // confirmAppointment em src/lib/conversation-pipeline.ts) — reforça o
  // comparecimento, não é um "vídeo de boas-vindas" genérico (nome antigo
  // do campo, renomeado por ser impreciso: o vídeo só é enviado DEPOIS do
  // agendamento confirmado, não no início do atendimento).
  confirmationVideoUrl String?

  // Delay de resposta da IA quando o lead está em silêncio há até 1h (ver
  // computeAdaptiveDelaySeconds em src/lib/scheduler.ts) — por clínica,
  // não global: cada uma pode querer um tom de "primeira resposta"
  // diferente. Válido de 30 a 60 (segundos); validado em
  // updateAiAgentSettings. As outras duas faixas (1-6h, 6h+) continuam
  // fixas e globais, sem campo — nem aqui nem em AiSettings.
  firstBandDelaySeconds Int @default(45)

  reminderConfig        ReminderConfig?
  instagramAccount      InstagramAccount?
  googleCalendarAccount GoogleCalendarAccount?
  connectionLinks       ConnectionLink[]

  users           User[]
  leads           Lead[]
  conversations   Conversation[]
  appointments    Appointment[]
  weeklySummaries WeeklySummary[]
  approachLogs    ApproachLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole

  // Nulo para usuários internos (acesso a todas as clínicas)
  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
}

// ---------------------------------------------------------------------------
// Integrações (OAuth) — nunca armazenar senha, apenas tokens revogáveis
// ---------------------------------------------------------------------------

model InstagramAccount {
  id       String @id @default(cuid())
  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  igUserId       String // ID do usuário/página profissional no Instagram
  igUsername     String?
  facebookPageId String

  accessTokenEnc String    @db.Text // token de página, criptografado em repouso
  tokenExpiresAt DateTime?

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Link público de auto-conexão (ex: /conectar/{token}) — permite o CLIENTE
// (a clínica) conectar seus próprios canais sem login no CRM e sem precisar
// do Mauro por perto. Token não-adivinhável, gerado à parte do id da
// clínica (nunca expõe o id real numa URL pública). Um link por canal
// (google-calendar | instagram — WhatsApp continua com o QR code próprio,
// nunca passa por aqui): cada card em Conexões gera/cancela o seu próprio,
// independente dos outros, mesma estrutura reaproveitada de canal pra
// canal. Invalidado OU por expiração (7 dias, ver createConnectionLink) OU
// no primeiro uso bem-sucedido (usedAt) — o que vier primeiro.
model ConnectionLink {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  channel   String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([clinicId])
}

model GoogleCalendarAccount {
  id       String @id @default(cuid())
  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  googleAccountEmail String
  calendarId         String @default("primary")

  accessTokenEnc  String    @db.Text
  refreshTokenEnc String    @db.Text
  tokenExpiresAt  DateTime?

  // Token de sincronização incremental (ver src/lib/google-calendar-sync.ts)
  // — null significa "nunca sincronizou ainda" ou "token expirou, refazer
  // do zero"; preenchido a cada rodada com o nextSyncToken do Google.
  syncToken String?

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Leads / conversas / mensagens
// ---------------------------------------------------------------------------

enum ConversationStatus {
  NEW // novo contato — lead respondeu à primeira mensagem manual
  IN_CONVERSATION // em conversa com a IA
  SCHEDULED // agendamento confirmado
  FOLLOW_UP // sumiu / não compareceu — em fluxo de reengajamento
  LOST // não retomou após follow-up
  NEEDS_HUMAN // escalonado — IA parou de responder
}

model Lead {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  igScopedId String // IGSID — identificador do lead escopado à conta da clínica
  igUsername String?
  name       String? // nome usado na abordagem manual do Mauro
  phone      String?

  conversations Conversation[]
  appointments  Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, igScopedId])
  @@index([clinicId])
}

model Conversation {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  status           ConversationStatus  @default(NEW)
  // Status de antes de entrar em FOLLOW_UP por não-comparecimento — guardado
  // só pra poder desfazer (voltar pra onde estava) quando alguém desmarca o
  // "Não compareceu"; ver setAppointmentAttendance em src/lib/appointments.ts.
  // Sempre null fora dessa janela.
  previousStatus   ConversationStatus?
  needsHumanReason String?             @db.Text

  lastLeadMessageAt DateTime?
  lastAiMessageAt   DateTime?
  lastMessageAt     DateTime?

  messages     Message[]
  appointments Appointment[]
  followUps    FollowUpLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, status])
  @@index([clinicId, createdAt])
  @@index([leadId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  LEAD
  AI
  HUMAN
  SYSTEM // ex: vídeo de boas-vindas, lembrete
}

enum MessageStatus {
  PENDING // aguardando horário de envio (timing adaptativo)
  SENT
  FAILED
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction MessageDirection
  sender    MessageSender
  content   String           @db.Text
  mediaUrl  String? // ex: vídeo do médico

  igMessageId String?

  status       MessageStatus @default(SENT)
  scheduledFor DateTime? // usado por mensagens OUTBOUND com delay adaptativo
  sentAt       DateTime?
  failReason   String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([status, scheduledFor])
}

// ---------------------------------------------------------------------------
// Agendamentos / lembretes / follow-up
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

// conversationId/leadId são opcionais: um agendamento pode vir da IA
// (Lead + Conversation sempre presentes, criado por conversation-pipeline.ts)
// ou ser importado direto do Google Calendar da clínica sem nenhum Lead
// vinculado (paciente conhecido, agendado manualmente, sem conversa no
// Instagram) — ver plano de sincronização de leitura do Google Calendar.
model Appointment {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  scheduledAt   DateTime
  googleEventId String?

  // Só preenchidos pra agendamentos importados do Google Calendar sem Lead
  // (sync de leitura) — manualTitle vem do "summary" do evento, usado como
  // nome de exibição já que não há Lead pra tirar o nome.
  manualTitle      String?
  syncedFromGoogle Boolean @default(false)

  status                  AppointmentStatus @default(SCHEDULED)
  confirmationVideoSentAt DateTime?

  reminderLogs ReminderLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, scheduledAt])
  @@index([clinicId, createdAt])
  @@index([status])
}

// Configuração de lembretes por clínica (padrão: 24h e 3h antes)
model ReminderConfig {
  id       String @id @default(cuid())
  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  hoursBefore Int[] @default([24, 3])

  updatedAt DateTime @updatedAt
}

model ReminderLog {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  hoursBefore Int
  sentAt      DateTime @default(now())
  channel     String   @default("instagram")

  @@unique([appointmentId, hoursBefore])
}

// Duas sequências de follow-up independentes, cada uma com seu próprio
// gatilho:
//  - SILENCE: automático — o lead para de responder ANTES de agendar
//    (ver FollowUpSettings.silenceHours). Deixa de valer assim que a
//    conversa chega a SCHEDULED; a partir daí é só lembrete/no-show.
//  - NO_SHOW: manual — só a secretária sabe se o paciente compareceu, então
//    só é ativado pelo botão "Não compareceu" (ver src/lib/appointments.ts
//    e a tela do agendamento), nunca por detecção automática.
enum FollowUpTrigger {
  SILENCE
  NO_SHOW
}

model FollowUpLog {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  trigger     FollowUpTrigger
  triggeredAt DateTime        @default(now())
  respondedAt DateTime?

  // Progresso na sequência configurável (FollowUpStep, mesmo trigger).
  // Posição (índice, base 0) do último passo já enviado nesta execução do
  // follow-up — null enquanto nenhum passo foi enviado ainda.
  lastStepIndex  Int?
  lastStepSentAt DateTime?

  @@index([conversationId])
}

// Sequência de follow-up configurável pelo CRM interno (/crm/follow-up) —
// uma lista por trigger (SILENCE e NO_SHOW são independentes, cada uma com
// seus próprios passos). Global (usada por todas as clínicas). `order` é só
// chave de ordenação dentro do trigger; a posição (0-based) da lista
// ordenada é o que referencia FollowUpLog.lastStepIndex.
model FollowUpStep {
  id      String          @id @default(cuid())
  trigger FollowUpTrigger
  order   Int

  // Dias desde o gatilho (lead sumiu ou faltou) para o primeiro passo;
  // dias desde o envio do passo anterior para os demais.
  offsetDays Int

  content       String  @db.Text
  attachmentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trigger, order])
}

// Configuração global do gatilho automático "parou de responder". Linha
// única (id fixo "singleton").
model FollowUpSettings {
  id           String @id @default("singleton")
  silenceHours Int    @default(24)

  // Janela de envio (horário de Brasília, ver src/lib/follow-up-window.ts) —
  // mensagens de follow-up só saem dentro dela; fora, esperam a próxima
  // ocorrência válida em vez de disparar na hora. windowDays usa a convenção
  // do Date.getDay(): 0=domingo .. 6=sábado. Minutos são desde a meia-noite
  // (ex: 480 = 08:00, 1080 = 18:00).
  windowDays        Int[] @default([1, 2, 3, 4, 5])
  windowStartMinute Int   @default(480)
  windowEndMinute   Int   @default(1080)

  updatedAt DateTime @updatedAt
}

// Configuração global do timing de resposta da IA. Linha única (id fixo
// "singleton"), igual ao padrão de FollowUpSettings. adaptiveDelayEnabled
// desligado é usado durante testes (ver computeAdaptiveDelaySeconds em
// src/lib/scheduler.ts) — a IA responde sem o delay artificial de
// agendamento, direto. A faixa "até 1h" (firstBandDelaySeconds) NÃO mora
// aqui — é por clínica, ver Clinic.firstBandDelaySeconds.
model AiSettings {
  id                   String   @id @default("singleton")
  adaptiveDelayEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

// Cores do sistema (design tokens), editáveis visualmente pela tela
// "Configurações" (ver src/lib/theme.ts para os valores padrão e as
// descrições de cada campo). Linha única (id fixo "singleton"), mesmo
// padrão de AiSettings/FollowUpSettings. Cada coluna guarda um hex
// ("#rrggbb") — é o formato que <input type="color"> usa nativamente;
// vira "R G B" (pra opacidade do Tailwind funcionar) só na hora de
// montar o style inline em src/app/layout.tsx.
model ThemeSettings {
  id String @id @default("singleton")

  vexoBg           String @default("#0b0f17")
  vexoSurface      String @default("#141a24")
  vexoSurface2     String @default("#1b222e")
  vexoBorder       String @default("#232c3a")
  vexoBorderStrong String @default("#33404f")
  vexoMuted        String @default("#8b96a8")
  vexoFg           String @default("#f1f4f8")
  vexoAccent       String @default("#3b82f6")
  vexoAccentFg     String @default("#ffffff")
  vexoPetrol       String @default("#0B2436")
  vexoPetrolBorder String @default("#1e4459")
  vexoSuccess      String @default("#34d399")
  vexoError        String @default("#f87171")
  vexoWarning      String @default("#fbbf24")

  updatedAt DateTime @updatedAt
}

// Override de cor por elemento de UMA página específica (ex: só a borda
// esquerda do card do Pipeline, sem afetar a borda do card da Agenda),
// mesmo que hoje as duas sigam o mesmo token global. Cada campo elegível
// vive registrado em src/lib/page-style-overrides.ts com uma chave fixa
// (ex: "pipeline.cardBorderLeft") — a PRESENÇA de uma linha aqui é o que
// significa "personalizado nesta página"; ausência = continua seguindo a
// cor global normalmente (ver THEME_FIELDS). Ligar/desligar o toggle
// "Personalizar só nesta página" na tela de Configurações cria ou apaga a
// linha correspondente, nunca deixa "enabled=false" com valor esquecido.
model PageStyleOverride {
  id    String @id // chave do campo, ex: "pipeline.cardBorderLeft"
  value String // cor hex ("#rrggbb")

  updatedAt DateTime @updatedAt
}

// A primeira mensagem é sempre enviada manualmente por Mauro, fora da
// plataforma (ver especificação — nenhuma automação de disparo em massa).
// Este registro é apenas um contador manual para alimentar o painel do
// cliente e o resumo semanal com o número de abordagens feitas.
model ApproachLog {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  loggedDate DateTime // data da abordagem (meia-noite, timezone da clínica)
  count      Int

  createdAt DateTime @default(now())

  @@index([clinicId, loggedDate])
}

// ---------------------------------------------------------------------------
// Resumo semanal (WhatsApp, sexta-feira)
// ---------------------------------------------------------------------------

model WeeklySummary {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  weekStart DateTime
  weekEnd   DateTime

  approachedCount Int
  respondedCount  Int
  scheduledCount  Int
  noShowCount     Int
  completedCount  Int

  sentAt    DateTime?
  sendError String?

  createdAt DateTime @default(now())

  @@unique([clinicId, weekStart])
}
