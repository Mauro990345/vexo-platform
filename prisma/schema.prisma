// VEXO — schema de dados multi-tenant
// Cada Clinic é um tenant isolado (conversas, leads, integrações, usuários).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy / usuários
// ---------------------------------------------------------------------------

enum UserRole {
  INTERNAL_ADMIN // Mauro / equipe M8 Growth — acesso total ao CRM
  INTERNAL_STAFF // secretária/atendente interna — acesso ao CRM
  CLIENT // login da clínica — painel somente leitura
}

model Clinic {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  timezone String  @default("America/Sao_Paulo")
  active   Boolean @default(true)

  // Endereço físico da clínica — alimenta automaticamente o campo de
  // localização do evento criado no Google Calendar (ver createCalendarEvent
  // em src/lib/google-calendar.ts), pra não precisar digitar o endereço em
  // dois lugares diferentes. Nome da(s) doutora(s) fica só no texto do
  // prompt por clínica, sem campo próprio.
  address String?

  // Piloto 21D
  pilotStartedAt DateTime?
  pilotEndsAt    DateTime?

  // Contato para escalonamento humano e resumo semanal
  notifyWhatsappNumber String? // Mauro/secretária desta clínica
  clientWhatsappNumber String? // número da clínica p/ resumo semanal

  // Instância própria na Evolution API — cada clínica tem seu próprio
  // WhatsApp, pareado via QR code (ver src/lib/whatsapp-connection.ts).
  // Default (na criação) é o slug da clínica; pode ser renomeado antes do
  // primeiro pareamento, ex. pra reaproveitar uma instância já validada.
  whatsappInstanceName    String?   @unique
  // Último estado confirmado via GET /instance/connectionState — "open" |
  // "connecting" | "close" | "unknown". Não é live: só atualiza quando
  // alguém abre a tela de conexão ou clica em "verificar conexão".
  whatsappStatus          String?
  whatsappStatusCheckedAt DateTime?

  // Prompt de conversação (fornecido pelo Mauro, por clínica)
  aiSystemPrompt String? @db.Text

  // Vídeo fixo do médico (gravado uma vez) enviado automaticamente pelo
  // Instagram assim que um agendamento é confirmado na conversa (ver
  // confirmAppointment em src/lib/conversation-pipeline.ts) — reforça o
  // comparecimento, não é um "vídeo de boas-vindas" genérico (nome antigo
  // do campo, renomeado por ser impreciso: o vídeo só é enviado DEPOIS do
  // agendamento confirmado, não no início do atendimento).
  confirmationVideoUrl String?

  // Frase enviada como mensagem de texto separada, logo ANTES do vídeo
  // acima (a API do Instagram não permite combinar texto + mídia numa
  // mensagem só) — explica pro lead o que é aquele vídeo que está prestes
  // a chegar. Antes era um texto fixo no código (não editável por
  // clínica); null usa um texto padrão genérico (ver DEFAULT_
  // CONFIRMATION_VIDEO_CAPTION em conversation-pipeline.ts).
  confirmationVideoCaption String? @db.Text

  // Delay de resposta da IA quando o lead está em silêncio há até 1h (ver
  // computeAdaptiveDelaySeconds em src/lib/scheduler.ts) — por clínica,
  // não global: cada uma pode querer um tom de "primeira resposta"
  // diferente. Válido de 5 a 60 (segundos); validado em
  // updateAiAgentSettings. As outras duas faixas (1-6h, 6h+) continuam
  // fixas e globais, sem campo — nem aqui nem em AiSettings.
  firstBandDelaySeconds Int @default(45)

  reminderConfig        ReminderConfig?
  instagramAccount      InstagramAccount?
  googleCalendarAccount GoogleCalendarAccount?
  connectionLinks       ConnectionLink[]
  connectionBundles     ConnectionBundle[]
  clientPanelLink       ClientPanelLink?

  users           User[]
  leads           Lead[]
  conversations   Conversation[]
  appointments    Appointment[]
  weeklySummaries WeeklySummary[]
  approachLogs    ApproachLog[]
  resultPhotos    ResultPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole

  // Nulo para usuários internos (acesso a todas as clínicas)
  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
}

// ---------------------------------------------------------------------------
// Integrações (OAuth) — nunca armazenar senha, apenas tokens revogáveis
// ---------------------------------------------------------------------------

model InstagramAccount {
  id       String @id @default(cuid())
  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  igUserId       String // ID da conta profissional no Instagram
  igUsername     String?
  // Opcional — o fluxo atual (Instagram API with Instagram Login) não passa
  // mais por uma Página do Facebook, então nunca é preenchido em conexões
  // novas. Coluna mantida (não removida) só pra não quebrar linhas antigas
  // de antes dessa migração, que ainda têm o valor da Página vinculada na
  // época; nada no app lê esse campo.
  facebookPageId String?

  accessTokenEnc String    @db.Text // token de acesso do Instagram, criptografado em repouso
  tokenExpiresAt DateTime?

  // false logo após o OAuth de uma conta nova — nenhum endpoint desse fluxo
  // (api.instagram.com/oauth/access_token, graph.instagram.com/me) devolve
  // o mesmo ID que a Meta manda de verdade em entry.id/recipient.id nos
  // webhooks (ver comentário grande em exchangeInstagramCode,
  // src/lib/instagram.ts), então o igUserId salvo pelo OAuth é só um
  // palpite até o primeiro evento de webhook real confirmar (ou corrigir)
  // esse valor — ver a auto-correção em handleInboundInstagramMessage,
  // conversation-pipeline.ts. Contas já existentes antes desse campo
  // (@default(true)) são tratadas como já verificadas: se já recebiam
  // mensagem normalmente, o ID salvo já está certo.
  webhookIdVerified Boolean @default(true)

  // Conexão SEGUNDA e OPCIONAL, separada da conexão principal acima —
  // "Login do Facebook para Empresas" (produto DIFERENTE do "Instagram API
  // with Instagram Login" usado pra tudo mais neste model), só pra habilitar
  // a Business Discovery API (fields=business_discovery.username(...)), que
  // é exclusiva desse produto — não existe pelo Instagram Login (ver
  // investigação grande em getInstagramConversationParticipantProfilePicture,
  // instagram.ts, e a decisão de reintroduzir esse fluxo especificamente
  // pra foto de perfil, já que a Conversations API confirmadamente não
  // expõe esse dado). Token de PÁGINA do Facebook, não de conta do
  // Instagram — por isso campos próprios, nunca reaproveita accessTokenEnc
  // acima. NULL = clínica não conectou (recurso é só um bônus visual, o
  // resto do VEXO funciona sem isso).
  businessDiscoveryAccessTokenEnc String?   @db.Text
  businessDiscoveryPageId         String?
  businessDiscoveryConnectedAt    DateTime?

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Link público de auto-conexão (ex: /conectar/{token}) — permite o CLIENTE
// (a clínica) conectar seus próprios canais sem login no CRM e sem precisar
// do Mauro por perto. Token não-adivinhável, gerado à parte do id da
// clínica (nunca expõe o id real numa URL pública). Um link por canal
// (google-calendar | instagram — WhatsApp continua com o QR code próprio,
// nunca passa por aqui): cada card em Conexões gera/cancela o seu próprio,
// independente dos outros, mesma estrutura reaproveitada de canal pra
// canal. Invalidado OU por expiração (7 dias, ver createConnectionLink) OU
// no primeiro uso bem-sucedido (usedAt) — o que vier primeiro.
model ConnectionLink {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  channel   String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  // Presente quando este link nasceu junto de um ConnectionBundle (link
  // combinado, um por canal — ver ConnectionBundle abaixo) em vez de ter
  // sido gerado avulso pelo botão de um card específico em Conexões. Não
  // muda nada de como este link funciona sozinho (público-start/callback
  // continuam usando só channel+token, sem olhar bundleId) — só permite ao
  // callback OAuth achar o token do bundle pra redirecionar de volta pra
  // ele (ver comentário grande nos callbacks) em vez da tela de sucesso
  // terminal de um único canal.
  bundleId String?
  bundle   ConnectionBundle? @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([clinicId])
  @@index([bundleId])
}

// Link público único que cobre os dois canais de uma vez (Instagram +
// Google Calendar) — pensado pro onboarding de cliente real, que nunca
// acessa o CRM interno: em vez de mandar dois links separados, o Mauro
// manda um só, e o cliente conecta as duas contas na mesma página, uma
// depois da outra, vendo o progresso. Por baixo dos panos continua sendo
// dois ConnectionLink normais (um por canal, via bundleId acima) — o
// bundle em si não participa do fluxo OAuth, só agrupa e dá um token
// próprio pra página combinada (ver /conectar/[token]/page.tsx).
model ConnectionBundle {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  links ConnectionLink[]

  @@index([clinicId])
}

// Link permanente de login automático do cliente no painel dele (ver
// /acesso/[token]/route.ts) — substitui o fluxo de e-mail+senha
// (CreateClientLoginForm/createClientLogin): um clínica → um link, sem
// expiração e sem uso único (diferente de ConnectionLink/ConnectionBundle
// acima, que são de uso pontual/OAuth) — o cliente salva e reabre esse
// mesmo link sempre. "Gerar novo link" (ver regenerateClientPanelLink)
// sobrescreve o token nesta mesma linha, invalidando o link antigo na
// hora — não cria uma segunda linha, porque só existe UM link válido por
// clínica de cada vez. clinicId @unique (não só @@index) garante isso no
// banco, não só na lógica do action.
model ClientPanelLink {
  id       String @id @default(cuid())
  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  token String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoogleCalendarAccount {
  id       String @id @default(cuid())
  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  googleAccountEmail String
  calendarId         String @default("primary")

  accessTokenEnc  String    @db.Text
  refreshTokenEnc String    @db.Text
  tokenExpiresAt  DateTime?

  // Token de sincronização incremental (ver src/lib/google-calendar-sync.ts)
  // — null significa "nunca sincronizou ainda" ou "token expirou, refazer
  // do zero"; preenchido a cada rodada com o nextSyncToken do Google.
  syncToken String?

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Leads / conversas / mensagens
// ---------------------------------------------------------------------------

enum ConversationStatus {
  NEW // novo contato — lead respondeu à primeira mensagem manual
  IN_CONVERSATION // em conversa com a IA
  SCHEDULED // agendamento confirmado
  FOLLOW_UP // sumiu / não compareceu — em fluxo de reengajamento
  LOST // não retomou após follow-up
  NEEDS_HUMAN // escalonado — IA parou de responder
}

model Lead {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  igScopedId String // IGSID — identificador do lead escopado à conta da clínica
  igUsername String?
  name       String? // nome usado na abordagem manual do Mauro
  phone      String?

  // true depois da PRIMEIRA tentativa de getInstagramUserProfile (sucesso,
  // erro ou resposta sem "name" — ver handleInboundInstagramMessage,
  // conversation-pipeline.ts), pra nunca tentar de novo indefinidamente
  // quando o resultado é vazio de forma consistente (bug real em produção:
  // uma conta pública normal, sem nada de privado, ainda assim nunca
  // devolveu "name" — provavelmente restrição do app em modo
  // desenvolvimento da Meta pra contas que não são tester, não um erro de
  // código; ver PR que introduziu este campo). @default(false) preserva o
  // comportamento de autocorreção pra leads já existentes antes deste
  // campo — a primeira mensagem seguinte ainda tenta uma vez.
  nameLookupAttempted Boolean @default(false)

  // Mesmo padrão de nameLookupAttempted acima, só que pra
  // getInstagramConversationParticipantUsername (instagram.ts) — endpoint
  // DIFERENTE (Conversations API, não o lookup de perfil por IGSID), único
  // jeito encontrado de obter o @ real do Instagram: o payload do webhook
  // nunca traz, e o lookup de perfil por IGSID só expõe "name" (restrição
  // de privacidade da Meta pra esse node específico, ver comentário em
  // getInstagramUserProfile). @default(false) permite backfill automático
  // pra leads já existentes sem username — ver backfillLeadInstagramUsernames,
  // src/lib/lead-username-backfill.ts, e a nova tentativa em
  // handleInboundInstagramMessage (conversation-pipeline.ts) a cada
  // mensagem nova enquanto não tiver sido tentado.
  usernameLookupAttempted Boolean @default(false)

  // Mesmo racional de usernameLookupAttempted acima, MAS com uma diferença
  // real de design: ao contrário do @ (um identificador estável, uma vez
  // obtido nunca muda), a URL de foto de perfil que APIs da Meta devolvem é
  // tipicamente uma URL ASSINADA/temporária do CDN deles — padrão bem
  // conhecido em outras APIs da Meta (não confirmado especificamente pra
  // este campo, sem token de produção pra testar neste ambiente). Por isso
  // NÃO é um booleano "tentado uma vez" — é um timestamp da última busca, e
  // o lookup RE-busca periodicamente (ver PROFILE_PICTURE_REFRESH_WINDOW_MS
  // em lead-profile-picture-backfill.ts), pra se autocurar se a URL salva
  // expirar, em vez de ficar com uma foto quebrada pra sempre depois da
  // primeira tentativa.
  profilePictureUrl       String?
  profilePictureFetchedAt DateTime?

  conversations Conversation[]
  appointments  Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, igScopedId])
  @@index([clinicId])
}

model Conversation {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  status           ConversationStatus  @default(NEW)
  // Status de antes de entrar em FOLLOW_UP por não-comparecimento — guardado
  // só pra poder desfazer (voltar pra onde estava) quando alguém desmarca o
  // "Não compareceu"; ver setAppointmentAttendance em src/lib/appointments.ts.
  // Sempre null fora dessa janela.
  previousStatus   ConversationStatus?
  needsHumanReason String?             @db.Text

  lastLeadMessageAt DateTime?
  lastAiMessageAt   DateTime?
  lastMessageAt     DateTime?

  // Marca que a IA já enviou uma foto de resultado (antes/depois) nesta
  // conversa — usado pra travar em no máximo 1 por conversa (ver
  // send_result_photo em src/lib/anthropic.ts), mesma receita do
  // Appointment.confirmationVideoSentAt.
  resultPhotoSentAt DateTime?

  // Marca que o WhatsApp do lead já foi CONFIRMADO DENTRO DESTA CONVERSA
  // (ver save_lead_phone/schedule_appointment em conversation-pipeline.ts)
  // — bug real em produção: schedule_appointment aceitava Lead.phone já
  // preenchido de uma conversa ANTERIOR (mesma conta de Instagram) como se
  // bastasse, então a IA podia pular a pergunta do WhatsApp inteiramente
  // numa conversa nova. Como Lead é único por conta de Instagram e seus
  // campos persistem entre todas as Conversations que essa conta já teve,
  // um número informado numa conversa de teste antiga "vazava" pra
  // qualquer agendamento futuro da mesma conta, mesmo sendo outra pessoa
  // usando o mesmo Instagram (ex.: filha agendando com o telefone da mãe).
  // Este campo é o equivalente, em escopo de conversa, ao Lead.phone em
  // escopo de conta — só ele (nunca Lead.phone bruto) autoriza
  // schedule_appointment a aceitar um telefone "já sabido" sem exigir
  // save_lead_phone de novo nesta mesma conversa.
  leadPhoneConfirmedAt DateTime?

  // Preenchido em setConversationStatus quando alguém clica "Devolver para
  // a IA" (única chamada real que leva status pra IN_CONVERSATION — ver
  // clinicas/actions.ts). classifyConversation recebe o histórico INTEIRO
  // da conversa a cada mensagem nova; sem esse corte, o motivo original do
  // escalonamento continua lá no transcript pra sempre, e o classificador
  // (que julga a conversa toda, não só a mensagem nova) reescalona de
  // novo na primeira mensagem seguinte — mesmo com o texto sendo comercial
  // normal, porque a reclamação/pedido antigo nunca "aconteceu" de verdade
  // pro modelo, só o status no banco mudou. Ver handleInboundInstagramMessage
  // em conversation-pipeline.ts: só as mensagens depois desse timestamp
  // entram na classificação (o histórico completo continua indo pra
  // geração da resposta da IA, que se beneficia do contexto).
  humanReviewedAt DateTime?

  // Diagnóstico POR CONVERSA da última vez que o classificador do gatilho
  // SILENCE (classifyConversation, chamado por processSilentConversations
  // em follow-up.ts) avaliou esta conversa — bug real reportado: uma
  // conversa claramente elegível (silenciosa há muito mais que o limiar
  // configurado) nunca migrava pra FOLLOW_UP, e não havia NENHUM registro
  // consultável do motivo — só um console.log (invisível sem acesso a
  // log do Railway) e, mesmo esse, só um AGREGADO do ciclo inteiro
  // (FollowUpSettings.lastSilenceCheckError), não por conversa
  // específica. Atualizado TODA vez que esta conversa é avaliada — aceita,
  // recusada, ou erro (ex.: resposta do modelo que não veio em JSON
  // válido, ver o catch em classifyConversation) — nunca limpo depois,
  // fica como histórico da ÚLTIMA avaliação, mesmo que a conversa
  // eventualmente dispare ou mude de status.
  lastSilenceCheckAt        DateTime?
  lastSilenceCheckSuggested Boolean?
  lastSilenceCheckReason    String?   @db.Text
  // provider:model exatos que geraram a decisão acima (ex.:
  // "openrouter:openai/gpt-5.6-luna") — sem isso, não dava pra confirmar
  // qual modelo decidiu cada caso específico sem depender do valor ATUAL
  // (possivelmente trocado de novo depois) de LLM_PROVIDER.
  lastSilenceCheckModel String?

  messages     Message[]
  appointments Appointment[]
  followUps    FollowUpLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, status])
  @@index([clinicId, createdAt])
  @@index([leadId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  LEAD
  AI
  HUMAN
  SYSTEM // ex: vídeo de boas-vindas, lembrete
}

enum MessageStatus {
  PENDING // aguardando horário de envio (timing adaptativo)
  // "Reivindicada" por uma execução de dispatchDueMessages (src/lib/dispatch.ts)
  // que já está enviando de fato — nunca fica assim por muito tempo (só
  // durante a própria chamada de sendInstagramMessage/sendWhatsappMessage).
  // Existe pra resolver um bug real em produção: o vídeo de confirmação (e,
  // em tese, qualquer mensagem) sendo enviado em dobro sem nenhuma mensagem
  // duplicada do lead envolvida — a causa era o cron de despacho
  // (*/15 * * * * *, ver src/worker/index.ts) rodando de novo ANTES da
  // execução anterior terminar de processar seu próprio lote de até 50
  // mensagens (cada uma com uma chamada de API externa, fácil passar de
  // 15s no total): as duas execuções liam a MESMA leva de mensagens
  // PENDING (nenhuma tinha sido "reivindicada" ainda) e mandavam a mesma
  // mensagem duas vezes. PENDING -> SENDING é uma transição exclusiva (um
  // UPDATE condicionado em WHERE status='PENDING' só afeta a linha pra UMA
  // das execuções concorrentes) — ver claimMessage em dispatch.ts.
  SENDING
  SENT
  FAILED
}

// Canal de saída de uma mensagem OUTBOUND. Quase tudo é INSTAGRAM (a
// conversa em si); WHATSAPP existe só pro passo extra de reengajamento da
// sequência "não compareceu" (ver FollowUpStep.channel e
// dispatchFollowUpSteps, src/lib/follow-up.ts) — mesma tabela/timeline pra
// aparecer junto do resto do histórico da conversa na tela, mas despachado
// via Evolution API (sendWhatsappMessage) em vez da API do Instagram.
enum MessageChannel {
  INSTAGRAM
  WHATSAPP
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction MessageDirection
  sender    MessageSender
  content   String           @db.Text
  mediaUrl  String? // ex: vídeo do médico
  channel   MessageChannel   @default(INSTAGRAM)

  // @unique protege contra reentrega do webhook do Instagram (a Meta
  // reentrega "at least once" — se o VEXO demorar demais pra responder 200,
  // o mesmo evento chega de novo) virar uma segunda chamada real à API da
  // Anthropic pro mesmo mid — ver a checagem em
  // src/app/api/webhooks/instagram/route.ts, que consulta por esse campo
  // ANTES de chamar handleInboundInstagramMessage; esta constraint é a
  // rede de segurança pra corrida genuína (dois envios processados quase
  // ao mesmo tempo, antes de qualquer um terminar). NULL continua permitido
  // livremente (mensagens SYSTEM/follow-up/lembrete nunca têm mid do
  // Instagram) — unique em Postgres não considera NULL igual a NULL.
  igMessageId String? @unique

  status       MessageStatus @default(SENT)
  scheduledFor DateTime? // usado por mensagens OUTBOUND com delay adaptativo
  sentAt       DateTime?
  failReason   String?

  createdAt DateTime @default(now())
  // Usado só pra detectar uma mensagem presa em SENDING (processo do
  // worker derrubado no meio do envio, antes de conseguir marcar SENT ou
  // FAILED) — ver claimMessage/reclaimStaleSendingMessages em
  // src/lib/dispatch.ts. Prisma atualiza sozinho a cada write.
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([status, scheduledFor])
}

// ---------------------------------------------------------------------------
// Agendamentos / lembretes / follow-up
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

// conversationId/leadId são opcionais: um agendamento pode vir da IA
// (Lead + Conversation sempre presentes, criado por conversation-pipeline.ts)
// ou ser importado direto do Google Calendar da clínica sem nenhum Lead
// vinculado (paciente conhecido, agendado manualmente, sem conversa no
// Instagram) — ver plano de sincronização de leitura do Google Calendar.
model Appointment {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  scheduledAt   DateTime
  googleEventId String?

  // Só preenchidos pra agendamentos importados do Google Calendar sem Lead
  // (sync de leitura) — manualTitle vem do "summary" do evento, usado como
  // nome de exibição já que não há Lead pra tirar o nome.
  manualTitle      String?
  syncedFromGoogle Boolean @default(false)

  status                  AppointmentStatus @default(SCHEDULED)
  confirmationVideoSentAt DateTime?
  // Marcado pela ferramenta confirm_attendance (ver AgentTools,
  // src/lib/anthropic.ts) só depois que o lead confirma explicitamente que
  // vai comparecer E a IA já mandou a mensagem final da sequência (ex.:
  // "chegue uns 15 minutinhos antes..."). Bug real em produção: o vídeo
  // institucional saía logo depois de schedule_appointment confirmar o
  // horário — no meio da própria sequência de confirmação de presença,
  // antes do lead sequer responder "sim posso ir". Esse campo é o sinal
  // explícito que faltava (nada no código sabia identificar sozinho o fim
  // dessa sequência, que só existe como texto livre gerado pela IA) — ver
  // maybeSendConfirmationVideo, conversation-pipeline.ts, que agora exige
  // isto preenchido antes de mandar o vídeo.
  attendanceConfirmedAt DateTime?
  // Marcado ao ENFILEIRAR a mensagem de confirmação imediata por WhatsApp
  // (ver maybeSendWhatsappConfirmation, conversation-pipeline.ts) — mesmo
  // instante de "enfileirado", não de "efetivamente entregue pelo
  // WhatsApp", igual a confirmationVideoSentAt acima (o envio real fica a
  // cargo do worker de despacho, ver dispatchDueMessages). Diferente dos
  // lembretes de véspera (12h/3h antes, ver ReminderConfig/ReminderLog
  // abaixo) — esta é a confirmação imediata, disparada assim que o
  // agendamento existe E Lead.phone está disponível, não uma janela fixa
  // antes do horário marcado.
  whatsappConfirmationSentAt DateTime?

  reminderLogs ReminderLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, scheduledAt])
  @@index([clinicId, createdAt])
  @@index([status])
}

// Configuração de lembretes por clínica (padrão: 24h e 3h antes)
model ReminderConfig {
  id       String @id @default(cuid())
  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  hoursBefore Int[] @default([24, 3])

  // Texto de cada lembrete, editável por clínica — aceita {{primeiro_nome}}
  // e {{data_horario}} (ver applyReminderTemplate em src/lib/whatsapp.ts).
  // Null = usa o texto fixo padrão (formatReminderMessage), pra não quebrar
  // clínicas que nunca personalizaram.
  firstMessageTemplate  String? @db.Text
  secondMessageTemplate String? @db.Text

  updatedAt DateTime @updatedAt
}

model ReminderLog {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  hoursBefore Int
  sentAt      DateTime @default(now())
  channel     String   @default("instagram")

  @@unique([appointmentId, hoursBefore])
}

// Duas sequências de follow-up independentes, cada uma com seu próprio
// gatilho:
//  - SILENCE: automático — o lead para de responder ANTES de agendar
//    (ver FollowUpSettings.silenceHours). Deixa de valer assim que a
//    conversa chega a SCHEDULED; a partir daí é só lembrete/no-show.
//  - NO_SHOW: manual — só a secretária sabe se o paciente compareceu, então
//    só é ativado pelo botão "Não compareceu" (ver src/lib/appointments.ts
//    e a tela do agendamento), nunca por detecção automática.
enum FollowUpTrigger {
  SILENCE
  NO_SHOW
}

model FollowUpLog {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  trigger     FollowUpTrigger
  triggeredAt DateTime        @default(now())
  respondedAt DateTime?

  // Progresso na sequência configurável (FollowUpStep, mesmo trigger).
  // Posição (índice, base 0) do último passo já enviado nesta execução do
  // follow-up — null enquanto nenhum passo foi enviado ainda.
  lastStepIndex  Int?
  lastStepSentAt DateTime?

  @@index([conversationId])
}

// Sequência de follow-up configurável pelo CRM interno (/crm/follow-up) —
// uma lista por trigger (SILENCE e NO_SHOW são independentes, cada uma com
// seus próprios passos). Global (usada por todas as clínicas). `order` é só
// chave de ordenação dentro do trigger; a posição (0-based) da lista
// ordenada é o que referencia FollowUpLog.lastStepIndex.
model FollowUpStep {
  id      String          @id @default(cuid())
  trigger FollowUpTrigger
  order   Int

  // Horas desde o gatilho (lead sumiu ou faltou) para o primeiro passo;
  // horas desde o envio do passo anterior para os demais. Unificado em
  // horas (era dias) pra dar mais precisão — 24 = "1 dia", 48 = "2 dias",
  // ou qualquer valor intermediário como 12.
  offsetHours Int

  content       String  @db.Text
  attachmentUrl String?

  // Só WHATSAPP faz sentido fora da sequência SILENCE — reengajamento
  // extra da sequência NO_SHOW, pro telefone capturado no agendamento
  // (Lead.phone), complementar às mensagens por Instagram, não um
  // substituto delas (ver dispatchFollowUpSteps, src/lib/follow-up.ts).
  // Sem suporte a anexo por esse canal (Evolution API só manda texto aqui,
  // ver sendWhatsappMessage em src/lib/whatsapp.ts) — attachmentUrl é
  // ignorado quando channel = WHATSAPP.
  channel MessageChannel @default(INSTAGRAM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trigger, order])
}

// Configuração global do gatilho automático "parou de responder". Linha
// única (id fixo "singleton").
model FollowUpSettings {
  id           String @id @default("singleton")
  silenceHours Int    @default(24)

  // Janela de envio (horário de Brasília, ver src/lib/follow-up-window.ts) —
  // mensagens de follow-up só saem dentro dela; fora, esperam a próxima
  // ocorrência válida em vez de disparar na hora. windowDays usa a convenção
  // do Date.getDay(): 0=domingo .. 6=sábado. Minutos são desde a meia-noite
  // (ex: 480 = 08:00, 1080 = 18:00).
  windowDays        Int[] @default([1, 2, 3, 4, 5])
  windowStartMinute Int   @default(480)
  windowEndMinute   Int   @default(1080)

  // Diagnóstico da execução do worker, sem precisar de acesso a log do
  // Railway (bug real: FollowUpLog sempre vazia, mesmo com conversas
  // claramente elegíveis — causa raiz encontrada em processSilentConversations,
  // follow-up.ts: uma exceção em UMA conversa abortava o ciclo INTEIRO em
  // silêncio, sem rastro nenhum visível fora do console do worker, um
  // processo separado sem UI própria). Atualizado em TODA execução de
  // processFollowUps (a cada 30min, ver worker/index.ts) — sucesso limpa
  // lastSilenceCheckError (null), falha grava a mensagem do erro. Visível
  // em /crm/dispatch-status.
  lastSilenceCheckAt    DateTime?
  lastSilenceCheckError String?   @db.Text

  updatedAt DateTime @updatedAt
}

// Configuração global do timing de resposta da IA. Linha única (id fixo
// "singleton"), igual ao padrão de FollowUpSettings. adaptiveDelayEnabled
// desligado é usado durante testes (ver computeAdaptiveDelaySeconds em
// src/lib/scheduler.ts) — a IA responde sem o delay artificial de
// agendamento, direto. A faixa "até 1h" (firstBandDelaySeconds) NÃO mora
// aqui — é por clínica, ver Clinic.firstBandDelaySeconds.
model AiSettings {
  id                   String   @id @default("singleton")
  adaptiveDelayEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

// Cores do sistema (design tokens), editáveis visualmente pela tela
// "Configurações" (ver src/lib/theme.ts para os valores padrão e as
// descrições de cada campo). Linha única (id fixo "singleton"), mesmo
// padrão de AiSettings/FollowUpSettings. Cada coluna guarda um hex
// ("#rrggbb") — é o formato que <input type="color"> usa nativamente;
// vira "R G B" (pra opacidade do Tailwind funcionar) só na hora de
// montar o style inline em src/app/layout.tsx.
model ThemeSettings {
  id String @id @default("singleton")

  vexoBg           String @default("#0b0f17")
  vexoSurface      String @default("#141a24")
  vexoSurface2     String @default("#1b222e")
  vexoBorder       String @default("#232c3a")
  vexoBorderStrong String @default("#33404f")
  vexoMuted        String @default("#8b96a8")
  vexoFg           String @default("#f1f4f8")
  vexoAccent       String @default("#3b82f6")
  vexoAccentFg     String @default("#ffffff")
  vexoPetrol       String @default("#0B2436")
  vexoPetrolBorder String @default("#1e4459")
  vexoSuccess      String @default("#34d399")
  vexoError        String @default("#f87171")
  vexoWarning      String @default("#fbbf24")

  updatedAt DateTime @updatedAt
}

// Override de cor por elemento de UMA página específica (ex: só o fundo do
// card da coluna Agendado no Pipeline, sem afetar a borda do card da
// Agenda), mesmo que algumas sigam o mesmo token global. Cada campo
// elegível vive registrado em src/lib/page-style-overrides.ts com uma
// chave fixa (ex: "pipeline.column.scheduled.background") — a PRESENÇA de
// uma linha aqui é o que significa "personalizado nesta página"; ausência
// = continua seguindo a cor global (ou o defaultHex do próprio campo,
// quando não segue nenhuma global — ver THEME_FIELDS/PageStyleField).
// Ligar/desligar o toggle "Personalizar só nesta página" na tela de
// Configurações cria ou apaga a linha correspondente, nunca deixa
// "enabled=false" com valor esquecido.
model PageStyleOverride {
  id    String @id // chave do campo, ex: "pipeline.column.scheduled.background"
  value String // cor hex ("#rrggbb")

  updatedAt DateTime @updatedAt
}

// A primeira mensagem é sempre enviada manualmente por Mauro, fora da
// plataforma (ver especificação — nenhuma automação de disparo em massa).
// Este registro é apenas um contador manual para alimentar o painel do
// cliente e o resumo semanal com o número de abordagens feitas.
model ApproachLog {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  loggedDate DateTime // data da abordagem (meia-noite, timezone da clínica)
  count      Int

  createdAt DateTime @default(now())

  @@index([clinicId, loggedDate])
}

// Fotos de resultado (antes/depois) cadastradas por clínica, cada uma com
// uma categoria/tag livre (ex: "botox", "preenchimento labial") — a IA
// busca por categoria e anexa numa resposta quando o lead demonstra
// interesse específico naquele procedimento (ver send_result_photo em
// src/lib/anthropic.ts). Categoria é texto livre, não enum: procedimentos
// variam demais entre clínicas pra travar numa lista fixa.
model ResultPhoto {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  category String
  imageUrl String

  // Mensagem que a IA manda ANTES da foto (ex: "Separei um resultado real
  // de um procedimento parecido com o que você quer") — sem isso, a foto
  // saía sozinha (só o anexo, sem nenhum texto de acompanhamento — ver
  // buildResultPhotoMessages, src/lib/result-photo-message.ts), quebrando
  // o fluxo natural da conversa. Opcional de propósito: fotos já
  // cadastradas antes desse campo existir continuam funcionando exatamente
  // como antes (só a foto, sem legenda) até alguém preencher.
  caption String? @db.Text

  createdAt DateTime @default(now())

  @@index([clinicId, category])
}

// ---------------------------------------------------------------------------
// Resumo semanal (WhatsApp, sexta-feira)
// ---------------------------------------------------------------------------

model WeeklySummary {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  weekStart DateTime
  weekEnd   DateTime

  approachedCount Int
  respondedCount  Int
  scheduledCount  Int
  noShowCount     Int
  completedCount  Int

  sentAt    DateTime?
  sendError String?

  createdAt DateTime @default(now())

  @@unique([clinicId, weekStart])
}

// ---------------------------------------------------------------------------
// Diagnóstico de webhook (temporário — sem acesso a logs do Railway)
// ---------------------------------------------------------------------------

// Registra TODA requisição que chega em /api/webhooks/instagram, mesmo
// payload inválido ou assinatura que falha na verificação — propósito é
// confirmar, pela própria interface do VEXO, se a Meta está de fato
// tentando entregar alguma coisa (e o que exatamente), sem depender dos
// logs do Railway (sem acesso). Ver src/app/api/webhooks/instagram/route.ts.
model WebhookLog {
  id         String   @id @default(cuid())
  receivedAt DateTime @default(now())

  method         String
  rawBody        String  @db.Text
  signatureValid Boolean

  // Preenchido só quando handleInboundInstagramMessage não encontra
  // nenhuma InstagramAccount pro igUserId que veio no evento — antes só
  // virava um console.warn (invisível sem acesso a logs do Railway).
  // Guarda os dois lados da comparação (ID recebido vs. IDs conhecidos no
  // banco nesse momento) pra dar pra diagnosticar direto pela interface do
  // VEXO. NULL = não houve descarte por essa causa (requisição processada
  // normalmente, ou nem chegou a ter evento de mensagem).
  matchFailureReason String? @db.Text

  // Preenchido quando a conta É encontrada mas handleInboundInstagramMessage
  // lança uma exceção em qualquer ponto do processamento (classificação,
  // geração de resposta da IA, criação de lead/conversa/mensagem etc.) —
  // antes só virava console.error na rota (api/webhooks/instagram/route.ts),
  // invisível sem acesso a logs do Railway. Guarda o erro completo (mensagem
  // + stack) pra diagnosticar direto pela interface do VEXO, sem precisar
  // adivinhar em qual das várias etapas internas travou.
  processingError String? @db.Text

  @@index([receivedAt])
}
